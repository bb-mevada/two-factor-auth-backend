{
    // Visit https://aka.ms/tsconfig to read more about this file
    "compilerOptions": {
        "target": "esnext",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "strict": true,
        "skipLibCheck": true,
        "rootDir": "./src",
        "outDir": "./dist",
        "declaration": true,
        "sourceMap": false,
        "removeComments": true
    },
    "exclude": ["node_modules", "dist"],
    "include": ["src/**/*"]
}
